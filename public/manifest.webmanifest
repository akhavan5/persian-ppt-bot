{
  "id": "/",
  "name": "پاورپوینت‌ساز فارسی",
  "short_name": "پاورپوینت‌ساز",
  "description": "ساخت پاورپوینت فارسی و قابل‌ویرایش با هوش مصنوعی",
  "lang": "fa",
  "dir": "rtl",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8faff",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "productivity",
    "education",
    "business"
  ],
  "prefer_related_applications": false,
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "shortcuts": [
    {
      "name": "ساخت پاورپوینت جدید",
      "short_name": "ساخت جدید",
      "url": "/?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "وبلاگ و راهنما",
      "short_name": "وبلاگ",
      "url": "/blog",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "share_target": {
    "action": "/_share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            ".docx",
            ".pptx",
            ".xlsx",
            ".pdf",
            ".txt",
            ".md",
            ".csv",
            ".png",
            ".jpg",
            ".jpeg",
            "application/pdf",
            "text/plain",
            "text/csv",
            "image/png",
            "image/jpeg",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/?source=file",
      "name": "ساخت پاورپوینت از این فایل",
      "launch_type": "single-client",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "text/plain": [
          ".txt",
          ".md"
        ],
        "text/csv": [
          ".csv"
        ],
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ]
      }
    }
  ],
  "screenshots": [
    {
      "src": "/og-image.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "wide",
      "label": "ساخت پاورپوینت فارسی با هوش مصنوعی"
    }
  ]
}