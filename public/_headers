/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/*.png
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=2592000
  Access-Control-Allow-Origin: *

/fonts/Vazirmatn.zip
  Content-Type: application/zip
  Content-Disposition: attachment; filename="Vazirmatn.zip"

/fonts/BFonts.zip
  Content-Type: application/zip
  Content-Disposition: attachment; filename="BFonts.zip"

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/pwa.js
  Cache-Control: public, max-age=3600

/offline.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=3600

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# Telegram Mini App: Telegram Web صفحه را در iframe باز می‌کند؛ فقط خود تلگرام اجازه‌ی قاب‌گرفتن دارد. صفحه ایندکس نشود.
/app
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://web.telegram.org https://webk.telegram.org https://webz.telegram.org https://*.telegram.org
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
/app.html
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://web.telegram.org https://webk.telegram.org https://webz.telegram.org https://*.telegram.org
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
