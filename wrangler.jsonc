{
  "$schema": "node_modules/wrangler/config-schema.json",
  // نام Worker باید با نامی که در داشبورد کلودفلر برای اتصال گیت‌هاب می‌سازید یکی باشد
  "name": "persian-ppt-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Smart Placement: Worker را نزدیک D1 و سرویس‌های بیرونی (پیامک، درگاه، تلگرام) اجرا می‌کند؛
  // چون هر درخواست وب چندین پرس‌وجوی پشت‌سرهم به D1 دارد، فاصله‌ی Worker تا D1 مستقیم روی سرعت دکمه‌ها اثر می‌گذارد
  "placement": { "host": "pptsaz.ir:443" },

  // نسخه‌ی وب: فایل‌های پوشه‌ی public مستقیم از لبه‌ی کلودفلر سرو می‌شوند؛
  // Worker فقط برای مسیرهای زیر (API و تلگرام) اجرا می‌شود
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // سئو: آدرس‌های ناموجود به‌جای متن خام، صفحه‌ی public/404.html را با کد 404 و noindex می‌گیرند
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/api/*", "/telegram", "/setup", "/bale/*", "/bale-setup", "/rubika/*", "/rubika-setup", "/eitaa", "/robots.txt", "/sitemap.xml", "/yandex_85baee77d3c502ea.html", "/.well-known/assetlinks.json", "/student", "/thesis-defense", "/teacher", "/business", "/free", "/compare", "/telegram-bot", "/ppt-saz", "/text-to-pptx", "/word-to-pptx", "/pdf-to-pptx", "/ai-powerpoint-maker", "/online-powerpoint-maker", "/gamma-alternative", "/canva-alternative", "/slide-maker", "/pitch-deck", "/proposal-presentation", "/article-presentation", "/school-presentation", "/ppt-with-images", "/speaker-notes", "/medical-presentation", "/engineering-presentation", "/law-presentation", "/management-presentation", "/clergy-presentation", "/konkur-presentation", "/iranian-powerpoint-maker", "/persian-powerpoint-templates", "/ready-made-powerpoint", "/link-to-pptx", "/infographic-maker", "/handout-maker", "/excel-to-pptx", "/persian-font-download", "/mobile-powerpoint-maker", "/image-to-pptx", "/chatgpt-powerpoint-maker", "/powerpoint-topics", "/audio-slide-podcast", "/feed.xml", "/blog", "/blog/*"]
  },

  // متغیرها/رمزهایی که در داشبورد تنظیم می‌کنید با هر دیپلوی پاک نشوند
  "keep_vars": true,

  // D1: همه‌ی داده‌های کوچک (۱۰۰ هزار نوشتن در روز رایگان). بدون database_id، Wrangler هنگام اولین دیپلوی خودش می‌سازد و وصل می‌کند
  "d1_databases": [{ "binding": "DB", "database_name": "persian-ppt-bot-db" }],

  // KV فقط برای بایت‌های فایل‌های ساخته‌شده (یک نوشتن برای هر ارائه)؛ همان namespace قبلی
  "kv_namespaces": [{ "binding": "FILES", "id": "72ced82828e44f8984116448ff111735" }],

  // ۱) پاکسازی روزانه‌ی داده‌های منقضی‌شده در D1 + یادآوری پلن + اعتبار رایگان روزانه
  // ۲) هر ساعت (دقیقه‌ی ۴۷): یادآوری فعال‌سازی (ثبت‌نام کرده ولی هنوز ارائه نساخته: ۲۴ ساعت و ۵ تا ۷ روز بعد)؛ باید با ACTIVATION_CRON در src/activation-reminder.ts یکی باشد
  // ۳) هر ساعت (دقیقه‌ی ۲۷): نظرسنجی پایان پلن؛ باید با FEEDBACK_CRON در src/plan-feedback.ts یکی باشد
  // ۴) هر ساعت (دقیقه‌ی ۳۷): اعلان‌های چرخه‌ی عمر (پرداخت نیمه‌کاره، کم‌شدن اعتبار، پوستر/جزوه، ارائه‌ی بعدی، بازگشت، دعوت)؛ باید با LIFECYCLE_CRON در src/lifecycle.ts یکی باشد
  "triggers": { "crons": ["17 3 * * *", "47 * * * *", "27 * * * *", "37 * * * *"] },

  // Browser Rendering: ساخت PDF ارائه در ربات تلگرام (پلن رایگان: ۱۰ دقیقه مرورگر در روز؛ فقط با دکمه‌ی «PDF» کاربر مصرف می‌شود)
  "browser": { "binding": "BROWSER" },

  // Workers AI برای تولید تصویر اسلاید (بدون کلید API جدا)
  "ai": { "binding": "AI" },

  // چت پشتیبانی: جستجوی هوشمند در محتوای سایت (Cloudflare AI Search). اول در داشبورد (AI ← AI Search) یک instance با نام pptsaz-site بساز
  // و منبعش را وب‌سایت pptsaz.ir بگذار؛ بعد این خط را از کامنت دربیاور. بدون آن دستیار فقط با دانش ثابت جواب می‌دهد.
  "ai_search": [{ "binding": "SITE_SEARCH", "instance_name": "pptsaz-site" }],

  "workflows": [
    { "name": "persian-ppt-deck", "binding": "DECK_WORKFLOW", "class_name": "DeckWorkflow" },
    { "name": "persian-ppt-broadcast", "binding": "BROADCAST_WORKFLOW", "class_name": "BroadcastWorkflow" },
    { "name": "persian-ppt-ocr", "binding": "OCR_WORKFLOW", "class_name": "OcrWorkflow" },
    { "name": "persian-ppt-web-ocr", "binding": "WEB_OCR_WORKFLOW", "class_name": "WebOcrWorkflow" },
    // اسلاید صوتی و پادکست دو‌گوینده (Gemini TTS؛ همراه ارائه یا با دکمه‌ی زیر ارائه)
    { "name": "persian-ppt-audio", "binding": "AUDIO_WORKFLOW", "class_name": "AudioWorkflow" },
    // پوستر و جزوه‌ی Word که بعد از ساخت ارائه با دکمه‌ی زیر ارائه (تلگرام، سایت، Mini App) خواسته می‌شوند
    { "name": "persian-ppt-extra", "binding": "EXTRA_WORKFLOW", "class_name": "ExtraWorkflow" }
  ]
}
